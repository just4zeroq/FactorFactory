# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# 虚拟环境：依赖版本是研究口径的一部分（见 requirements.txt 的锁定说明），
# 环境本身不入库，用 requirements 复现。
venv/
.venv/
env/
ENV/
venv.bak/

# 测试与类型检查缓存
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# 编辑器 / 操作系统
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ---------------------------------------------------------------------------
# 运行时数据（不进版本库）
# ---------------------------------------------------------------------------
# 供给数据根、票据、账本、日志、缓存都由运行目录承载，默认在仓库外。
data/
logs/
.cache/
*.log

# 单次运行的产物目录（ticket / parcel / 账本 / 事件流）随 `run` / `pipeline`
# 生成，属可再生产物。验证基线不在这里——黄金面板夹具在
# tests/fixtures/golden/，随仓库提交。
user_workspace/
runs/
reports/

# 因子库是研究产物，随 promote 增长，不入库
factor_db/
factor_db_*/
db/

# 计划与结果的临时草稿
tmp/
*.tmp
.scratch/

# ---------------------------------------------------------------------------
# 本地研究草稿：挖掘战役的计划 / 产物 / 一次性诊断脚本
# ---------------------------------------------------------------------------
# 计划是每次 run 的预注册输入，属可再生的研究草稿；复制计划 + 指定 seed
# 即可复现，不入库。已验证的口径固化在产品代码与 tests/fixtures 中。
plan_*.json

# 根目录点开头的本地脚本/中间产物（.env.example 等例外见下）：
# 覆盖 .tmp_* / .campaign_* / .rN_run_* / .ff_report_* / .v2_* / .*_diag.py
# 以及 *.jsonl / *.txt 形式的临时输出。只作用于仓库根，不误伤子目录产品代码。
/.*
!/..gitignore
!/.gitignore
!/.gitattributes
!/.env.example

# WorkBuddy 本地会话/项目数据，非产品代码
.workbuddy/
.workbuddy-ai/

# ---------------------------------------------------------------------------
# 本地环境变量 / 凭据
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
secrets.yaml
secrets.yml
